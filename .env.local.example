# Supabase projekt URL és publishable key (Project Settings -> API -> Connect)
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Ha egy régebbi Supabase projekted van "anon key"-jel (legacy JWT alapú kulcs),
# azt is ide teheted ugyanebbe a változóba, működni fog:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Google Gemini API kulcs (Google AI Studio -> Get API key) -- a Felszereltség modul
# hangalapú/szabadszöveges AI-elemzéséhez (app/api/ai/parse-equipment). SOHA ne kapjon
# NEXT_PUBLIC_ előtagot -- csak szerveroldalon (Route Handler) használjuk.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase SERVICE ROLE kulcs (Project Settings -> API -> service_role, "secret" jelöléssel)
# -- KIZÁRÓLAG a "Fiók törlése" funkcióhoz (app/api/account/delete/route.ts,
# lib/supabase/admin.ts), mert egy user végleges törlése (auth.admin.deleteUser())
# csak a service-role admin API-val végezhető el. SOHA ne kapjon NEXT_PUBLIC_
# előtagot -- ez a kulcs megkerüli az ÖSSZES RLS policy-t, ha kiszivárogna a
# böngészőbe, bárki bármelyik cég adatához hozzáférne. Vercelen külön Environment
# Variable-ként állítsd be, "Sensitive" jelöléssel, ha van rá lehetőség.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe -- fizetési/előfizetés-kezelő integráció (Egyéni/Műhely Kereskedői/Profi havi
# csomag + "+10 Autó" eseti Top-up + AI-kredit csomagok), lásd
# app/api/stripe/checkout/route.ts + app/api/stripe/webhook/route.ts + lib/stripe.ts. A
# titkos kulcs SOHA ne kapjon NEXT_PUBLIC_ előtagot.
# Stripe Dashboard -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_OWN_KEY

# Stripe Dashboard -> Developers -> Webhooks -> (a végpont) -> Signing secret. Ez
# hitelesíti, hogy a /api/stripe/webhook végpontra érkező kérés TÉNYLEG a Stripe-tól jött.
# Helyi fejlesztéshez a Stripe CLI-vel is generálható: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_OWN_SECRET

# Stripe Dashboard -> Product catalog -> az adott ár (Price) azonosítója (price_...).
# STARTER/GROWTH/PRO (a belső azonosító, a megjelenített név 2026-08-07 óta Egyéni/Műhely
# Kereskedői/Profi, lásd components/settings/BillingTab.tsx PLAN_TIER_LABELS): havi
# előfizetés (Checkout mode: subscription). A `business` (Autóház) tier-nek SZÁNDÉKOSAN
# nincs price ID-ja -- egyedi ártárgyalás, kapcsolatfelvétel gombbal, nem önkiszolgáló
# Stripe Checkout tétel (lásd components/settings/BillingTab.tsx).
STRIPE_PRICE_ID_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Éves változatok (2026-08-07, "Havi/éves kapcsoló" lépés) -- kb. 20% kedvezmény a havi
# árhoz képest, a BillingTab.tsx havi/éves kapcsolója választja ki. A `resolvePlanAction`
# (app/api/stripe/webhook/route.ts) ugyanarra a plan_tier-re képezi le, mint a havi ár.
STRIPE_PRICE_ID_STARTER_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_GROWTH_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Egyszeri (nem lejáró) vásárlási tételek (Checkout mode: payment) -- lásd
# app/api/stripe/checkout/route.ts mode-választását (oneTimePurchasePriceIds halmaz).
# TOPUP_10: "+10 Autó" vizsgálat-csomag. AI_TOPUP_5/15/40: önállóan vásárolható
# AI-kredit-csomagok (2026-08-06, "Árazási struktúra bővítés" lépés) -- "1 AI-kredit = 1
# vizsgálat" (lásd lib/inspectionAiCredit.ts).
# FIGYELEM: a Stripe Price objektumok IMMUTÁBILISAK -- ha a TOPUP_10 ára változik (a
# korábbi 5900 Ft helyett mostantól 8500 Ft-ot mutat a BillingTab), Stripe Dashboard-on
# egy ÚJ Price-t kell létrehozni, és EZT az env változót arra az új price_...
# azonosítóra kell átállítani (a régi Price-t nem lehet szerkeszteni).
STRIPE_PRICE_ID_TOPUP_10=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_AI_TOPUP_5=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_AI_TOPUP_15=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_AI_TOPUP_40=price_xxxxxxxxxxxxxxxxxxxxxxxx
