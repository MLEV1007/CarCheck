# Supabase projekt URL és publishable key (Project Settings -> API -> Connect)
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Ha egy régebbi Supabase projekted van "anon key"-jel (legacy JWT alapú kulcs),
# azt is ide teheted ugyanebbe a változóba, működni fog:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Google Gemini API kulcs (Google AI Studio -> Get API key) -- a Felszereltség modul
# hangalapú/szabadszöveges AI-elemzéséhez (app/api/ai/parse-equipment). SOHA ne kapjon
# NEXT_PUBLIC_ előtagot -- csak szerveroldalon (Route Handler) használjuk.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase SERVICE ROLE kulcs (Project Settings -> API -> service_role, "secret" jelöléssel)
# -- KIZÁRÓLAG a "Fiók törlése" funkcióhoz (app/api/account/delete/route.ts,
# lib/supabase/admin.ts), mert egy user végleges törlése (auth.admin.deleteUser())
# csak a service-role admin API-val végezhető el. SOHA ne kapjon NEXT_PUBLIC_
# előtagot -- ez a kulcs megkerüli az ÖSSZES RLS policy-t, ha kiszivárogna a
# böngészőbe, bárki bármelyik cég adatához hozzáférne. Vercelen külön Environment
# Variable-ként állítsd be, "Sensitive" jelöléssel, ha van rá lehetőség.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
