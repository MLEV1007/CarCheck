# Supabase projekt URL és publishable key (Project Settings -> API -> Connect)
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Ha egy régebbi Supabase projekted van "anon key"-jel (legacy JWT alapú kulcs),
# azt is ide teheted ugyanebbe a változóba, működni fog:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
